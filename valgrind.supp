# Valgrind suppressions for LanceDB C bindings
# These suppress known false positives from Rust runtime and system libraries

# Suppress tokio:runtime allocations (possibly lost)
{
   tokio_runtime_possibly_lost
   Memcheck:Leak
   match-leak-kinds: possible
   fun:*alloc
   ...
   fun:*tokio*runtime*
   ...
}

# Suppress regex_automata allocations (possibly lost)
{
   regex_automata_cache_possibly_lost
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   ...
   fun:*regex_automata*
   ...
}

# lance moka cache leak — crossbeam channels not cleaned up on exit
{
   lance_moka_cache_leak
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   ...
   fun:*moka*base_cache*BaseCache*new*
   ...
}

# OpenDAL global operator registry — one-time static init via Once::call_once
{
   opendal_operator_registry_init
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:*
   ...
   fun:*opendal*
   ...
}

# DataFusion session context — interior pointers in Arc/HashMap misclassified by valgrind
{
   datafusion_session_context
   Memcheck:Leak
   match-leak-kinds: possible
   fun:*
   ...
   fun:*datafusion*
   ...
}

# geodatafusion UDF registration
{
   geodatafusion_udf_register
   Memcheck:Leak
   match-leak-kinds: possible
   fun:*
   ...
   fun:*geodatafusion*
   ...
}

# Lance DataFusion UDF registration (JSON UDFs, etc.)
{
   lance_datafusion_udf
   Memcheck:Leak
   match-leak-kinds: possible
   fun:*
   ...
   fun:*lance_datafusion*
   ...
}

# Lance index plugin registry — one-time static init
{
   lance_index_plugin_registry
   Memcheck:Leak
   match-leak-kinds: possible,definite
   fun:*
   ...
   fun:*IndexPluginRegistry*
   ...
}

# DashMap concurrent hash map — interior pointers from sharded RwLock layout
{
   dashmap_possibly_lost
   Memcheck:Leak
   match-leak-kinds: possible
   fun:*
   ...
   fun:*dashmap*DashMap*
   ...
}

# Arrow schema Fields::from_iter — Arc interior pointers misclassified by valgrind
{
   arrow_schema_fields_from_iter
   Memcheck:Leak
   match-leak-kinds: possible
   fun:*
   ...
   fun:*arrow_schema*fields*Fields*from_iter*
   ...
}

# URL parser allocations
{
   url_parser_possibly_lost
   Memcheck:Leak
   match-leak-kinds: possible
   fun:*
   ...
   fun:*url*parser*Parser*
   ...
}

# UUID formatting allocations
{
   uuid_fmt_possibly_lost
   Memcheck:Leak
   match-leak-kinds: possible
   fun:*
   ...
   fun:*uuid*fmt*
   ...
}

# Rust std allocates the Thread handle on the first access to a thread local
# (e.g. when the fastrand global RNG is seeded), and releases it on thread exit
{
   rust_std_thread_current_init
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   ...
   fun:*init_current*
   ...
}

# Same as above for builds with -DBUILD_COVERAGE=ON: with -Cinstrument-coverage
# valgrind resolves the std::thread::current::init_current frame to an adjacent
# __covrec_* coverage record symbol, so the suppression above does not match
{
   rust_std_thread_current_init_coverage
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   fun:*std*thread*Thread*new*
   fun:__covrec_*
   ...
}

# known glibc internal allocation in the DNS resolver
{
   glibc-resolver-cache
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   fun:__libc_alloc_buffer_allocate
   fun:alloc_buffer_allocate
   fun:__resolv_conf_allocate
}
